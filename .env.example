# Public client configuration only. VITE_* values are bundled into the browser.
VITE_API_URL=http://localhost:8000/api/v1
# Google AdSense Publisher ID (production only)
VITE_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX

# Backend/edge configuration is intentionally not exposed here.
# Store provider API keys (for example Anthropic or OpenRouter) in the
# backend/edge secret manager and access them only from server-side code.
